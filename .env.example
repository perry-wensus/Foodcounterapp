# Kopieer naar .env.local en vul in (Supabase dashboard > Project Settings > API).
# Alleen publieke waarden! De Claude API-sleutel hoort NIET hier maar als Supabase-secret:
#   npx supabase secrets set ANTHROPIC_API_KEY=...
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
